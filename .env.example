# Application Environment Configuration
# development | test | production  (production refuses to start without a real JWT_SECRET_KEY)
ENV=development
PORT=8000

# AI Provider Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (relative SQLite paths resolve against the repository root)
DATABASE_URL=sqlite:///./disputeiq.db

# Authentication
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Development conveniences: apply migrations and seed the demo dataset on startup.
# Set both to false in production and run `python backend/manage.py migrate` explicitly.
AUTO_MIGRATE=true
SEED_DEMO_DATA=true

# Phase 3 local evidence storage. Files are kept outside the database and are
# ignored by git. The default upload limit is 10 MiB.
EVIDENCE_STORAGE_PATH=./storage/evidence
EVIDENCE_MAX_FILE_SIZE=10485760

# Phase 4 document intelligence. VLM fallback is opt-in and never verifies authenticity.
ENABLE_VLM_PROCESSING=false

# Evaluation Settings
CONFIDENCE_THRESHOLD=0.75
